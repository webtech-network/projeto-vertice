{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/quiz-canvas-padrao.schema.json",
  "title": "Schema para Questões Avaliativas em Formato Padrão",
  "description": "Valida arquivos JSON de questões avaliativas no formato padronizado com course_id, quiz_id e lista de questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "course_id",
    "quiz_id",
    "questions"
  ],
  "properties": {
    "course_id": {
      "description": "Identificador do curso. Pode ser nulo quando ainda não definido.",
      "type": [
        "integer",
        "null"
      ]
    },
    "quiz_id": {
      "description": "Identificador do quiz/atividade. Pode ser nulo quando ainda não definido.",
      "type": [
        "integer",
        "null"
      ]
    },
    "questions": {
      "description": "Lista de questões avaliativas.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_name",
        "question_text",
        "points_possible"
      ],
      "properties": {
        "question_name": {
          "description": "Nome/título da questão.",
          "type": "string",
          "minLength": 1
        },
        "question_text": {
          "description": "Enunciado da questão, preferencialmente em HTML.",
          "type": "string",
          "minLength": 1
        },
        "question_type": {
          "description": "Tipo da questão no quiz clássico do Canvas. Ausente = multiple_choice_question.",
          "type": "string",
          "enum": [
            "multiple_choice_question",
            "essay_question",
            "text_only_question",
            "file_upload_question"
          ]
        },
        "points_possible": {
          "description": "Pontuação da questão (0 apenas em text_only_question).",
          "type": "number",
          "minimum": 0
        },
        "answers": {
          "description": "Lista de alternativas (somente múltipla escolha; vazia ou ausente nos tipos abertos).",
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/answer"
          }
        },
        "question_model": {
          "description": "Modelo pedagógico da questão.",
          "type": "string",
          "enum": [
            "AR",
            "AR (Asserção-Razão)",
            "RU",
            "RU (Resposta Única)",
            "CM",
            "CM (Complementação Múltipla)",
            "INT",
            "INT (Interpretação)",
            "DISC",
            "DISC (Dissertativa)"
          ]
        },
        "feedback_comment": {
          "description": "Comentário geral da questão, preferencialmente em HTML (no Canvas: neutral_comments_html).",
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "multiple_choice_question"
              }
            }
          },
          "then": {
            "required": [
              "answers",
              "question_model"
            ],
            "properties": {
              "answers": {
                "minItems": 2,
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "is_correct"
                      ],
                      "properties": {
                        "is_correct": {
                          "const": true
                        }
                      }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "question_type"
            ],
            "properties": {
              "question_type": {
                "enum": [
                  "essay_question",
                  "text_only_question",
                  "file_upload_question"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "answers": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "question_type"
            ],
            "properties": {
              "question_type": {
                "const": "text_only_question"
              }
            }
          },
          "then": {
            "properties": {
              "points_possible": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "points_possible": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_text",
        "is_correct",
        "answer_comment"
      ],
      "properties": {
        "answer_text": {
          "description": "Texto da alternativa.",
          "type": "string",
          "minLength": 1
        },
        "is_correct": {
          "description": "Indica se a alternativa é correta.",
          "type": "boolean"
        },
        "answer_comment": {
          "description": "Comentário explicativo da alternativa, preferencialmente em HTML.",
          "type": "string"
        }
      }
    }
  }
}
