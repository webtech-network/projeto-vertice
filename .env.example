# --- Web app, origem pública do próprio Next.js ---
# Usada por proxy.js e pelo logout para montar redirects — independente de
# qualquer provedor de login (ver src/lib/appUrl.js). Em dev, sem porta
# porque "npm run dev" roda em -p 80.
APP_URL=http://localhost

# --- CLI (npm run cli), personal access token — unchanged from v1 ---
CANVAS_API_URL=https://sua-instituicao.instructure.com/api/v1
CANVAS_API_TOKEN=

# --- Web app (npm run dev / build / start), Canvas OAuth2 Developer Key ---
CANVAS_DOMAIN=https://sua-instituicao.instructure.com
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=http://localhost/oauth2/callback
# Só é necessário se a Developer Key tiver "Enforce Scopes" habilitado; use os
# mesmos escopos habilitados na chave, separados por espaço.
CANVAS_OAUTH_SCOPES=

# --- Web app, conexão com GitHub (OAuth App clássico, não GitHub App) ---
# Crie em: GitHub → Settings → Developer settings → OAuth Apps.
# O token resultante não fica na sessão do servidor — o usuário conecta a
# própria conta em /perfil e o token é guardado no IndexedDB do navegador.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost/github/oauth2/callback
# Opcional — default: read:user repo project
GITHUB_OAUTH_SCOPES=

# --- Web app, conexão com Google Drive (appDataFolder) — OAuth2 code exchange,
# mesma estrutura do GitHub acima. Crie em: Google Cloud Console → APIs & Services
# → Credentials → OAuth Client ID (Web application) + habilite a Drive API no projeto.
# O token (access + refresh) não fica na sessão do servidor — fica no IndexedDB do
# navegador, mesmo padrão do GitHub; o client_secret nunca sai do servidor (usado só
# para trocar o código e para renovar o access_token via /api/google/refresh, já que
# ao contrário do GitHub o token do Google expira em ~1h).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/google/oauth2/callback
# Opcional — default: https://www.googleapis.com/auth/drive.appdata
GOOGLE_OAUTH_SCOPES=

# --- Web app, Supabase Auth (login: Google/GitHub/Canvas/passkey) ---
# Fase 1 do Vértice — ver /Users/rommelcarneiro/.claude/plans/preciso-realizar-uma-mudan-a-eager-pine.md.
# Aponta para o Kong do stack local em supabase/ (docker compose up -d lá).
# NEXT_PUBLIC_SUPABASE_ANON_KEY é pública (vai pro bundle do browser); nunca
# coloque a SERVICE_ROLE_KEY numa variável NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web app, criptografia da sessão ---
# Ainda necessária na Fase 1 só para aiApiKeys/aiModels (migração pra Postgres
# é Fase 2) — deixa de ser usada para autenticação/gate de rota, que passa a
# ser 100% responsabilidade da sessão Supabase acima.
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Geração de questões com IA (múltiplos provedores, src/lib/aiProviders) ---
# Todas opcionais — se vazias, cada adaptador usa seu próprio defaultModel.
# Não há *_API_KEY aqui: cada usuário cadastra sua própria chave por provedor
# em /perfil, guardada apenas na sessão (cookie criptografado), nunca como
# config compartilhada.
OPENAI_MODEL=
GEMINI_MODEL=
CLAUDE_MODEL=
