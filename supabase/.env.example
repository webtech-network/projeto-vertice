# Stack mínimo de Supabase self-hosted (Vértice, Fase 1) — db + auth + rest +
# realtime + kong. Copie para .env e preencha antes de "docker compose up -d".
# NUNCA versionar o .env real (.gitignore já cobre isso).

# --- Postgres ---
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- JWT compartilhado entre auth/rest/realtime/kong ---
# Gere com: openssl rand -base64 48 | tr -d '\n' | cut -c1-64
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRY=3600

# ANON_KEY / SERVICE_ROLE_KEY: JWTs HS256 assinados com o JWT_SECRET acima,
# claim "role": "anon" / "service_role" (+ "iss"/"iat"/"exp" — use um exp bem
# no futuro, não a validade de sessão de usuário). Gere com:
#   JWT_SECRET=<mesmo-valor-de-cima> node generate-jwt.mjs
# ANON_KEY vai para NEXT_PUBLIC_SUPABASE_ANON_KEY no .env do app (público).
# SERVICE_ROLE_KEY vai para SUPABASE_SERVICE_ROLE_KEY no .env do app — NUNCA
# em código que roda no browser.
ANON_KEY=
SERVICE_ROLE_KEY=

# --- URLs públicas ---
# Origem pública onde o Kong deste stack fica exposto.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
KONG_HTTP_PORT=8000

# Origem pública do app Next.js (Vértice) — usada pelo GoTrue para montar
# links/redirects.
SITE_URL=http://localhost:3000
# Lista extra de redirect URIs permitidos, separados por vírgula (além de
# SITE_URL). Necessário se o app rodar em mais de uma origem (ex: preview
# deployments).
ADDITIONAL_REDIRECT_URLS=

# --- Login: só OAuth nesta fase, sem e-mail/senha nem SMTP ---
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true

# --- Google (provedor built-in do GoTrue) ---
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- GitHub (provedor built-in do GoTrue) ---
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=

# --- Canvas: não entra aqui ---
# Spike concluído — GoTrue self-hosted não tem uma entrada "canvas" na sua
# lista fixa de provedores embutidos (só Google/GitHub/Azure/Discord/...).
# Login com Canvas é feito por um bridge próprio no app Next.js
# (CANVAS_OAUTH_* no .env do app + Admin API do Supabase), não por config
# aqui. Ver "Canvas como provedor de login" no plano da Fase 1.

# --- Passkeys / WebAuthn (beta do GoTrue, mai/2026 — opt-in) ---
PASSKEYS_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000

# --- Realtime ---
# EXATAMENTE 16 bytes/caracteres — usado como chave AES-128 direto (não é
# hex-decodificado). openssl rand -hex 16 gera 32 caracteres e QUEBRA o
# Realtime ("Bad key size") — use -hex 8 (16 hex chars = 16 bytes).
# Gere com: openssl rand -hex 8
REALTIME_DB_ENC_KEY=
# Gere com: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=
